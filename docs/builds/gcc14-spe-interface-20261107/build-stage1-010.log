if [ -d include-fixed ] ; then true; else mkdir include-fixed; chmod a+rx include-fixed; fi
for file in .. /work/modern/gcc/ginclude/float.h /work/modern/gcc/ginclude/iso646.h /work/modern/gcc/ginclude/stdarg.h /work/modern/gcc/ginclude/stdbool.h /work/modern/gcc/ginclude/stddef.h /work/modern/gcc/ginclude/varargs.h /work/modern/gcc/ginclude/stdfix.h /work/modern/gcc/ginclude/stdnoreturn.h /work/modern/gcc/ginclude/stdalign.h /work/modern/gcc/ginclude/stdatomic.h /work/modern/gcc/ginclude/stdckdint.h /work/modern/gcc/config/powerpcspe/ppc-asm.h /work/modern/gcc/config/powerpcspe/altivec.h /work/modern/gcc/config/powerpcspe/spe.h /work/modern/gcc/config/powerpcspe/ppu_intrinsics.h /work/modern/gcc/config/powerpcspe/paired.h /work/modern/gcc/config/powerpcspe/spu2vmx.h /work/modern/gcc/config/powerpcspe/vec_types.h /work/modern/gcc/config/powerpcspe/si2vmx.h /work/modern/gcc/config/powerpcspe/htmintrin.h /work/modern/gcc/config/powerpcspe/htmxlintrin.h; do \
  if [ X$file != X.. ]; then \
    realfile=`echo $file | sed -e 's|.*/\([^/]*\)$|\1|'`; \
    echo timestamp > include/$realfile; \
    rm -f include/$realfile; \
    cp $file include; \
    chmod a+r include/$realfile; \
  fi; \
done
for file in .. ; do \
  if [ X$file != X.. ]; then \
            mv include/$file include/x_$file; \
            echo "#include_next <$file>" >include/$file; \
            cat include/x_$file >>include/$file; \
            rm -f include/x_$file; \
    chmod a+r include/$file; \
  fi; \
done
for file in .. ; do \
  if [ X$file != X.. ]; then \
    echo "#include_next <$file>" >>include/$file; \
    chmod a+r include/$file; \
  fi; \
done
rm -f include/stdint.h
if [ wrap = wrap ]; then \
  rm -f include/stdint-gcc.h; \
  cp /work/modern/gcc/ginclude/stdint-gcc.h include/stdint-gcc.h; \
  chmod a+r include/stdint-gcc.h; \
  cp /work/modern/gcc/ginclude/stdint-wrap.h include/stdint.h; \
  chmod a+r include/stdint.h; \
elif [ wrap = provide ]; then \
  cp /work/modern/gcc/ginclude/stdint-gcc.h include/stdint.h; \
  chmod a+r include/stdint.h; \
fi
set -e; for ml in `cat fixinc_list`; do \
  sysroot_headers_suffix=`echo ${ml} | sed -e 's/;.*$//'`; \
  multi_dir=`echo ${ml} | sed -e 's/^[^;]*;//'`; \
  include_dir=include${multi_dir}; \
  if [ -f `echo /opt/tabor-sdk-candidate/lib/gcc/powerpc-linux-gnuspe/14.2.0/../../../../powerpc-linux-gnuspe/sys-include | sed -e :a -e 's,[^/]*/\.\.\/,,' -e ta`/limits.h ] ; then \
    cat /work/modern/gcc/limitx.h /work/modern/gcc/glimits.h /work/modern/gcc/limity.h > tmp-xlimits.h; \
  else \
    cat /work/modern/gcc/glimits.h > tmp-xlimits.h; \
  fi; \
  /bin/bash /work/modern/gcc/../mkinstalldirs ${include_dir}; \
  chmod a+rx ${include_dir} || true; \
  /bin/bash /work/modern/gcc/../move-if-change \
    tmp-xlimits.h  tmp-limits.h; \
  rm -f ${include_dir}/limits.h; \
  cp -p tmp-limits.h ${include_dir}/limits.h; \
  chmod a+r ${include_dir}/limits.h; \
  cp /work/modern/gcc/gsyslimits.h ${include_dir}/syslimits.h; \
done
if [ xstmp-fixinc != x ]; then \
  rm -f include-fixed/README; \
  cp /work/modern/gcc/../fixincludes/README-fixinc include-fixed/README; \
  chmod a+r include-fixed/README; \
fi;
echo timestamp > stmp-int-hdrs
