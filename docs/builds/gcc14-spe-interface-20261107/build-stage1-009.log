if /work/build-stage1/./gcc/xgcc -B/work/build-stage1/./gcc/  -print-sysroot-headers-suffix > /dev/null 2>&1; then \
  set -e; for ml in `/work/build-stage1/./gcc/xgcc -B/work/build-stage1/./gcc/  -print-multi-lib`; do \
    multi_dir=`echo ${ml} | sed -e 's/;.*$//'`; \
    flags=`echo ${ml} | sed -e 's/^[^;]*;//' -e 's/@/ -/g'`; \
    sfx=`/work/build-stage1/./gcc/xgcc -B/work/build-stage1/./gcc/  ${flags} -print-sysroot-headers-suffix`; \
    if [ "${multi_dir}" = "." ]; \
      then multi_dir=""; \
    else \
      multi_dir=/${multi_dir}; \
    fi; \
    echo "${sfx};${multi_dir}"; \
  done; \
else \
  echo ";"; \
fi > tmp-fixinc_list
