+static const uint32_t dce_v11_0_primary_formats_be[] = {
+	DRM_FORMAT_BGRX8888,	/* host-order XRGB8888: legacy ADDFB 32/24, fbdev */
+	DRM_FORMAT_BGRA8888,	/* host-order ARGB8888: legacy ADDFB 32/32 */
