sed -e "s%@libc@%libc6%g" \
    -e "s%@archs@%amd64 arc arm64 armel armhf hppa i386 loong64 m68k mips mipsel mipsn32 mipsn32el mips64 mips64el mipsr6 mipsr6el mipsn32r6 mipsn32r6el mips64r6 mips64r6el nios2 powerpc powerpcspe ppc64 ppc64el riscv64 sparc sparc64 s390x sh3 sh4 x32%g" \
    -e "s%@libc-dev-conflict@%libc6.1-dev, libc0.3-dev,%g" \
    < debian/control.in/libc > debian/control.in/libc6
sed -e "s%@libc@%libc6.1%g" \
    -e "s%@archs@%alpha%g" \
    -e "s%@libc-dev-conflict@%libc6-dev, libc0.3-dev,%g" \
    < debian/control.in/libc > debian/control.in/libc6.1
sed -e "s%@libc@%libc0.3%g" \
    -e "s%@archs@%hurd-i386 hurd-amd64%g" \
    -e "s%@libc-dev-conflict@%libc6-dev, libc6.1-dev,%g" \
    < debian/control.in/libc > debian/control.in/libc0.3
# Check that all files end with a new line
set -e ; for i in debian/control.in/* ; do \
	tail -n1 $i | grep -q "^$" ; \
done
cat debian/control.in/main		>  /source/stamp-dir/controlT
cat debian/control.in/libc6		>> /source/stamp-dir/controlT
cat debian/control.in/libc6.1		>> /source/stamp-dir/controlT
cat debian/control.in/libc0.3		>> /source/stamp-dir/controlT
cat debian/control.in/i386		>> /source/stamp-dir/controlT
cat debian/control.in/sparc		>> /source/stamp-dir/controlT
cat debian/control.in/sparc64		>> /source/stamp-dir/controlT
cat debian/control.in/s390 		>> /source/stamp-dir/controlT
cat debian/control.in/amd64		>> /source/stamp-dir/controlT
cat debian/control.in/powerpc		>> /source/stamp-dir/controlT
cat debian/control.in/ppc64		>> /source/stamp-dir/controlT
cat debian/control.in/mips32		>> /source/stamp-dir/controlT
cat debian/control.in/mipsn32		>> /source/stamp-dir/controlT
cat debian/control.in/mips64		>> /source/stamp-dir/controlT
cat debian/control.in/x32		>> /source/stamp-dir/controlT
sed -e 's%@libc@%libc6%g' -e 's%@DEB_VERSION_UPSTREAM@%2.41%g' -e 's%@DEB_GCC_VERSION@%%g' < /source/stamp-dir/controlT > debian/control
rm /source/stamp-dir/controlT
# And generate the tests control file with the current GCC
sed -e 's%@triggers@%binutils, linux-libc-dev [linux-any], gcc%g' debian/tests/control.in > debian/tests/control
touch /source/stamp-dir/control
