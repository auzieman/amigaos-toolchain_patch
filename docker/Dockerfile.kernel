# Supply a reviewed digest, e.g. debian:bookworm-slim@sha256:... .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 git build-essential gcc-powerpc-linux-gnu binutils-powerpc-linux-gnu \
    bc bison flex libssl-dev libelf-dev cpio kmod rsync u-boot-tools \
    ca-certificates xz-utils file && rm -rf /var/lib/apt/lists/*
COPY scripts/kernel-build.py /opt/tabor/kernel-build.py
WORKDIR /work
ENTRYPOINT ["python3", "/opt/tabor/kernel-build.py"]
