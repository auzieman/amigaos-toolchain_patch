ARG BUILD_INFRA_IMAGE
FROM ${BUILD_INFRA_IMAGE}
# Native Debian changelog, package-note and manual-page generation tools.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-debian dh-package-notes libjpeg-turbo-progs=1:2.1.5-4 \
    && test -z "$(dpkg --audit)" \
    && dpkg-query -W > /opt/tabor-bin-nmu-tools-installed.txt \
    && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["python3"]
