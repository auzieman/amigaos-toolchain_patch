--- a/debian/rules
+++ b/debian/rules
@@ -30,3 +30,13 @@
 
 override_dh_strip:
 	dh_strip --dbgsym-migration='libpcre2-dbg (<< 10.34-2~)'
+
+# Preserve Debian regex symbol prefixes/hardening and append experimental SPE ABI.
+ifneq ($(TABOR_SYSROOT),)
+export DEB_CFLAGS_MAINT_APPEND += -mcpu=8548 -mabi=spe -mspe -mfloat-gprs=double -mlong-double-128
+override_dh_shlibdeps:
+	dh_shlibdeps -- -l$(TABOR_SYSROOT)/lib -l$(TABOR_SYSROOT)/usr/lib -L$(TABOR_SHLIBS)
+
+override_dh_builddeb:
+	dh_builddeb -- -Zgzip -Snone
+endif
