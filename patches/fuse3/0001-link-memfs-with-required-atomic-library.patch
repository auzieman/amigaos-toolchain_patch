Description: Link the C++ memfs example with libatomic when required
 The compile/link-only probe covers targets whose 64-bit atomics use runtime
 helpers, including 32-bit SPE. Preserve examples and never execute target
 code during configuration. Other targets retain their existing linkage.
Author: Tabor port contributors
Forwarded: not-yet
Last-Update: 2026-11-03

--- a/example/meson.build
+++ b/example/meson.build
@@ -35,8 +35,20 @@
     executable('passthrough_hp', 'passthrough_hp.cc',
                dependencies: [ thread_dep, libfuse_dep ],
                install: false)
+    cpp = meson.get_compiler('cpp')
+    atomic64_test = '''
+        #include <atomic>
+        int main() {
+            std::atomic<unsigned long long> value(0);
+            return value.fetch_add(1, std::memory_order_relaxed);
+        }
+    '''
+    atomic64_dep = declare_dependency()
+    if not cpp.links(atomic64_test, name: 'C++ 64-bit atomic operations')
+        atomic64_dep = cpp.find_library('atomic', required: true)
+    endif
     executable('memfs_ll', 'memfs_ll.cc',
-               dependencies: [ thread_dep, libfuse_dep ],
+               dependencies: [ thread_dep, libfuse_dep, atomic64_dep ],
                cpp_args : '-std=c++17',
                install: false)
 endif
