+/*
+ * Polaris11 big-endian: the UVD encoder ring is software LE (patch 0023) and the
+ * engine fetches IBs LE, so kernel-built encoder messages are stored LE, as VCE does.
+ */
+static void uvd_v6_0_enc_encode_ib(struct amdgpu_ring *ring, struct amdgpu_ib *ib)
+{
+	unsigned int i;
+
+	if (!amdgpu_ring_uses_sw_le(ring))
+		return;
+	for (i = 0; i < ib->length_dw; i++)
+		ib->ptr[i] = (__force u32)cpu_to_le32(ib->ptr[i]);
+}
