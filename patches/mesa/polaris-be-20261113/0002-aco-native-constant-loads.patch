+#if UTIL_ARCH_BIG_ENDIAN
+/* NIR large-constant storage is host-native. Unlike executable words, it
+ * remains a byte section through ACO assembly and upload. Decode each loaded
+ * scalar at its declared width; a whole-blob dword swap would corrupt mixed
+ * 8/16/32/64-bit layouts.
+ */
+static nir_def*
+reverse_constant_dword(nir_builder* b, nir_def* value)
+{
+   nir_def* lo = nir_ior(b, nir_ishl_imm(b, value, 24),
+                       nir_ishl_imm(b, nir_iand_imm(b, value, 0xff00), 8));
+   nir_def* hi = nir_ior(b, nir_ushr_imm(b, value, 24),
+                       nir_ushr_imm(b, nir_iand_imm(b, value, 0xff0000), 8));
+   return nir_ior(b, lo, hi);
+}
+
+static bool
+decode_native_constant(nir_builder* b, nir_instr* instr, void*)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr* load = nir_instr_as_intrinsic(instr);
+   if (load->intrinsic != nir_intrinsic_load_constant || load->def.bit_size <= 8)
+      return false;
+
+   b->cursor = nir_after_instr(instr);
+   nir_def* decoded[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < load->def.num_components; i++) {
+      nir_def* value = nir_channel(b, &load->def, i);
+      if (load->def.bit_size == 64) {
+         nir_def* lo = nir_unpack_64_2x32_split_x(b, value);
+         nir_def* hi = nir_unpack_64_2x32_split_y(b, value);
+         decoded[i] = nir_pack_64_2x32_split(b, reverse_constant_dword(b, hi),
+                                           reverse_constant_dword(b, lo));
+      } else if (load->def.bit_size == 16) {
+         value = nir_u2u32(b, value);
+         decoded[i] = nir_u2u16(b, nir_ior(b, nir_ishl_imm(b, value, 8),
+                                           nir_ushr_imm(b, value, 8)));
+      } else {
+         assert(load->def.bit_size == 32);
+         decoded[i] = reverse_constant_dword(b, value);
+      }
+   }
+   nir_def* result = nir_vec(b, decoded, load->def.num_components);
+   nir_def_rewrite_uses_after(&load->def, result, result->parent_instr);
+   return true;
+}
+#endif
 
