+/* Return the REG_MODE piece at byte OFFSET of the MODE value X for
+   rs6000_split_multireg_move.  A MEM piece is the MEM itself, offset, as
+   GCC 8's simplify_subreg returned.  GCC 14's simplify_subreg refuses MEMs
+   aligned below REG_MODE on STRICT_ALIGNMENT targets, and Linux SPE
+   defaults to -mstrict-align, so an A32 TFmode stack slot split into
+   DFmode pieces would otherwise yield a null destination.  */
+
+static rtx
+rs6000_split_multireg_piece (machine_mode reg_mode, rtx x, machine_mode mode,
+			     int offset)
+{
+  if (MEM_P (x)
+      && !mode_dependent_address_p (XEXP (x, 0), MEM_ADDR_SPACE (x))
+      && (!MEM_VOLATILE_P (x) || !have_insn_for (SET, mode)))
+    return adjust_address_nv (x, reg_mode, offset);
+  return simplify_gen_subreg (reg_mode, x, mode, offset);
+}
