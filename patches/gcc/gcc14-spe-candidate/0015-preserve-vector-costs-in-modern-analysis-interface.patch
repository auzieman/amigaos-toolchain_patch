+/* Bridge the legacy SPE target costs to GCC14's per-analysis interface. */
+class rs6000_spe_vector_costs : public vector_costs
+{
+public:
+  rs6000_spe_vector_costs (vec_info *vinfo, bool scalar)
+    : vector_costs (vinfo, scalar)
+  {
+    loop_vec_info loop_vinfo = dyn_cast<loop_vec_info> (vinfo);
+    m_data = (rs6000_cost_data *) rs6000_init_cost
+      (loop_vinfo ? LOOP_VINFO_LOOP (loop_vinfo) : NULL);
+    m_data->vinfo = vinfo;
+  }
+  ~rs6000_spe_vector_costs () override { rs6000_destroy_cost_data (m_data); }
+  unsigned int add_stmt_cost (int count, vect_cost_for_stmt kind,
+                              stmt_vec_info stmt, slp_tree,
+                              tree vectype, int misalign,
+                              vect_cost_model_location where) override
+  {
+    unsigned int cost = rs6000_add_stmt_cost
+      (m_data, count, kind, stmt, misalign, where, vectype);
+    m_costs[where] = m_data->cost[where];
+    return cost;
+  }
+  void finish_cost (const vector_costs *scalar_costs) override
+  {
+    rs6000_finish_cost (m_data, &m_costs[vect_prologue],
+                        &m_costs[vect_body], &m_costs[vect_epilogue]);
+    vector_costs::finish_cost (scalar_costs);
+  }
+private:
+  rs6000_cost_data *m_data;
+};
+
+static vector_costs *
+rs6000_spe_create_costs (vec_info *vinfo, bool scalar)
+{ return new rs6000_spe_vector_costs (vinfo, scalar); }
 
 /* Handler for the Mathematical Acceleration Subsystem (mass) interface to a
