Cross-build dependency correction: javac/JNI header tooling and nasm are
executed by the build host, not linked as target runtime libraries. Preserve
Debian's architecture restrictions and feature selection; do not ask apt for
SPE executables merely to run these generators on the native build host.

--- a/debian/control
+++ b/debian/control
@@ -6,9 +6,9 @@
 Build-Depends: cmake,
                debhelper-compat (= 13),
-               default-jdk [!hppa !hurd-any !powerpc],
+               default-jdk:native [!hppa !hurd-any !powerpc],
                help2man,
                javahelper,
-               nasm,
+               nasm:native,
 Rules-Requires-Root: no
 Standards-Version: 4.7.0
 Homepage: https://www.libjpeg-turbo.org/
