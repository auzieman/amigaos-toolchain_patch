# Patch payloads retain upstream context indentation and blank context lines.
patches/**/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Keep captured serial bytes/hash; CRLF is emitted by the guest console.
docs/builds/*-serial.log -text whitespace=-blank-at-eol,cr-at-eol
# Preserve raw fractal serial evidence and its receipt checksum.
docs/builds/fractal-*/serial.log -text whitespace=-blank-at-eol,cr-at-eol
# Preserve accepted shell serial evidence and its receipt checksum.
docs/builds/shell-*/serial.log -text whitespace=-blank-at-eol,cr-at-eol
docs/builds/abi-*/serial.log -text whitespace=-blank-at-eol,cr-at-eol
docs/builds/qemu11-*/*serial.log -text whitespace=-blank-at-eol,cr-at-eol
*.ppm binary
# Raw kernel/storage serial capture retains CR/CRLF and its receipt hash.
docs/builds/boot-candidate-*/kernel-storage-*.log -text whitespace=-blank-at-eol,cr-at-eol
# Preserve raw configure/compiler evidence, including emitted trailing spaces.
docs/builds/source-coverage-20261102/*-tail.log -text whitespace=-blank-at-eol
