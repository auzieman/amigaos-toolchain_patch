# Candidate physical USB kernel; configuration/build is not graphics acceptance.
CONFIG_FUTEX=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_MULTIUSER=y
CONFIG_UNIX98_PTYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_EHCI_FSL=y
CONFIG_USB_EHCI_HCD_PPC_OF=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_DRM=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Polaris has legacy DCE support. Start without DC/kernel floating-point code;
# verify actual KMS/firmware on the physical board before accepting this choice.
CONFIG_DRM_AMD_DC=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Explicit physical-board memory, CPU and desktop prerequisites.
CONFIG_SMP=y
CONFIG_MMU=y
CONFIG_HIGHMEM=y
CONFIG_PHYS_64BIT=y
CONFIG_PTE_64BIT=y
CONFIG_SPE=y
CONFIG_SYSVIPC=y
CONFIG_INOTIFY_USER=y

# Normal Debian init/session and persistent-root prerequisites.
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# Modular graphics candidate: preserve disk root/network independently.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_LOCALVERSION="-tabor-modular"
CONFIG_LOCALVERSION_AUTO=n
